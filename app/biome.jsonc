{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // style.css is ordered by screen, not by specificity, and its !important flags are deliberate (print, reduced motion)
      "style": {
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      // a name used but not imported is an error (the modules share nothing else)
      "correctness": {
        "noUndeclaredVariables": "error"
      },
      "a11y": {
        // the app has no <form>, so a button can't submit anything: type="button" would be noise
        "useButtonType": "off",
        // rows, messages and calendar blocks take clicks as mouse shortcuts; the keyboard has its own
        // keys for them (events.js)
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off"
      }
    }
  },
  "overrides": [
    {
      // the icons sit in buttons that carry the label (title / aria-label), as they always have
      "includes": ["web/app/icons.jsx"],
      "linter": { "rules": { "a11y": { "noSvgWithoutTitle": "off" } } }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
