{
  "appId": "sh.deni.dude",
  "productName": "dude",
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "files": ["ui/**", "*.js", "*.png", "package.json", "!*.test.js"],
  "linux": {
    "target": "AppImage",
    "category": "Office",
    "executableArgs": ["--no-sandbox"],
    "icon": "icon.png"
  },
  "mac": {
    "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
    "category": "public.app-category.productivity",
    "icon": "icon.png",
    "identity": "-",
    "hardenedRuntime": false
  },
  "win": {
    "target": "nsis",
    "icon": "icon.png"
  }
}
