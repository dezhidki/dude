{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/calendar/**",
              "components/controls/**",
              "components/mail/**",
              "components/overlays/**",
              "components/shell/**",
              "ui_kits/mail/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:rail|pane|enter|children|key|ref|className|style)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: rail, pane, enter, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute[name.name='enter'] > Literal[value!=/^(?:enter-fade|enter-in)$/]",
        "message": "<AppShell> enter must be one of 'enter-fade' | 'enter-in'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Attachment'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|onOpen|onSave|key|ref|className|style|children)$/]",
        "message": "<Attachment> doesn't accept that prop. Declared props: name, size, onOpen, onSave."
      },
      {
        "selector": "JSXOpeningElement[name.name='AttachmentChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|onClick|key|ref|className|style|children)$/]",
        "message": "<AttachmentChip> doesn't accept that prop. Declared props: name, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:email|inline|onLogin|key|ref|className|style|children)$/]",
        "message": "<AuthBar> doesn't accept that prop. Declared props: email, inline, onLogin."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|primary|danger|icon|keyHint|title|onClick|children|key|ref|className|style)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, primary, danger, icon, keyHint, title, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:main|secondary|soft|outline|toolbar|quiet|caps|save|link|banner|alert)$/]",
        "message": "<Button> variant must be one of 'main' | 'secondary' | 'soft' | 'outline' | 'toolbar' | 'quiet' | 'caps' | 'save' | 'link' | 'banner' | 'alert'."
